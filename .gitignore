# Local environment and secrets
.env
.env.local
.env.*
!.env.example

# Build and dependency output
node_modules/
vendor/
result
result-*
dist/
build/

# Devenv
.devenv*
devenv.local.nix
devenv.local.yaml

# pre-commit
.pre-commit-config.yaml

# Generated by devenv shell as symlinks into the local Nix store, so they differ per machine.
# Personal overrides for Claude Code live in .claude/settings.local.json (inside the ignored .claude/).
/.mcp.json
/.claude/
/.pi/settings.json

# Nix direnv state from before devenv
.direnv/

# Logs
*.log
npm-debug.log*

# IDE / editor directories
/.idea
/.zed
/.fleet
/.nova

# VS Code: ignore everything except shared config
/.vscode/*
!/.vscode/mcp.json
!/.vscode/settings.json

# OS / editor cruft
.DS_Store
Thumbs.db
